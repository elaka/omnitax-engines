# Runtime artifacts — the engines never write inside the package tree by
# default (see OMNITAX_WORM_LEDGER_DIR / OMNITAX_IDEMPOTENCY_STORE), but
# guard against stray local runs all the same.
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.jsonl

